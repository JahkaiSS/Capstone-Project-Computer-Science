import tkinter as tk
from tkinter import messagebox, ttk

from config import CELL_SIZE, MAX_ORDER_LENGTH, WINDOW_HEIGHT, WINDOW_WIDTH
from models import Building
from order_manager import DemoWMSIntegration, OrderBatcher
from routing import RoutingEngine
from topology import WarehouseTopology


class WarehouseRouteApp(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Rexroth Picking Route Optimizer — Demonstration")
        self.geometry(f"{WINDOW_WIDTH}x{WINDOW_HEIGHT}")
        self.minsize(800, 550)
        self.topology = WarehouseTopology()
        self.wms = DemoWMSIntegration(self.topology)
        self.batcher = OrderBatcher(self.wms)
        self.routing_engine = RoutingEngine(self.topology)
        self.current_route = []
        self.current_route_index = 0
        self.current_items = []
        self._create_interface()
        self._draw_warehouse()

    def _create_interface(self):
        top = ttk.Frame(self, padding=10)
        top.pack(fill="x")
        ttk.Label(top, text="Order Number:").pack(side="left")
        self.order_entry = ttk.Entry(top, width=22)
        self.order_entry.pack(side="left", padx=8)
        self.order_entry.bind("<Return>", lambda _event: self.calculate_route())
        ttk.Button(top, text="Calculate Route", command=self.calculate_route).pack(side="left", padx=4)
        ttk.Button(top, text="Next Stop", command=self.next_area).pack(side="left", padx=4)
        ttk.Button(top, text="Retry / Reset", command=self.reset).pack(side="left", padx=4)

        info = ttk.Frame(self, padding=(10, 0, 10, 8))
        info.pack(fill="x")
        self.status_label = ttk.Label(info, text="Enter a demo order number (1001–1004).", wraplength=900)
        self.status_label.pack(anchor="w")
        self.distance_label = ttk.Label(info, text="Route distance: — grid steps")
        self.distance_label.pack(anchor="w", pady=(4, 0))
        self.next_area_label = ttk.Label(info, text="Next stop: —")
        self.next_area_label.pack(anchor="w", pady=(4, 0))

        body = ttk.Panedwindow(self, orient="horizontal")
        body.pack(fill="both", expand=True, padx=10, pady=(0, 10))
        map_frame = ttk.Frame(body)
        details_frame = ttk.Frame(body, padding=(8, 0, 0, 0))
        body.add(map_frame, weight=4)
        body.add(details_frame, weight=1)

        self.canvas = tk.Canvas(map_frame, background="white", highlightthickness=1, highlightbackground="#bbbbbb")
        vbar = ttk.Scrollbar(map_frame, orient="vertical", command=self.canvas.yview)
        hbar = ttk.Scrollbar(map_frame, orient="horizontal", command=self.canvas.xview)
        self.canvas.configure(yscrollcommand=vbar.set, xscrollcommand=hbar.set)
        self.canvas.grid(row=0, column=0, sticky="nsew")
        vbar.grid(row=0, column=1, sticky="ns")
        hbar.grid(row=1, column=0, sticky="ew")
        map_frame.rowconfigure(0, weight=1)
        map_frame.columnconfigure(0, weight=1)

        ttk.Label(details_frame, text="Pick list", font=("Arial", 11, "bold")).pack(anchor="w")
        self.item_list = tk.Listbox(details_frame, width=34, height=14, activestyle="none")
        self.item_list.pack(fill="both", expand=True, pady=(6, 0))
        ttk.Label(details_frame, text="Gray cells = blocked/demo rack areas\nGreen marker = current stop\nBlue line = planned path", wraplength=220).pack(anchor="w", pady=8)

    def calculate_route(self):
        try:
            order_number = self.order_entry.get().strip()
            if not order_number:
                raise ValueError("Order number cannot be empty.")
            if len(order_number) > MAX_ORDER_LENGTH:
                raise ValueError(f"Order number cannot exceed {MAX_ORDER_LENGTH} characters.")
            if not order_number.isdigit():
                raise ValueError("Order number must contain digits only.")

            items = self.batcher.CreateBatches([order_number])
            destinations = [item.location for item in items]
            start = self.topology.get_location(Building.A, 0, 0)
            result = self.routing_engine.CalculateRoute(start, destinations)

            self.current_items = items
            self.current_route = result.route
            self.current_route_index = 0
            self.distance_label.config(text=f"Route distance: {result.distance} grid steps (includes demo building transition)")
            self.item_list.delete(0, tk.END)
            for item in items:
                self.item_list.insert(tk.END, f"{item.item_number}  ×{item.quantity}")
                self.item_list.insert(tk.END, f"   {item.location.display_name()}")
                self.item_list.insert(tk.END, "")
            self.status_label.config(text=f"Route created for demo order {order_number}. Verify the map against the real warehouse before operational use.")
            self.update_next_area()
            self._draw_warehouse()
        except ValueError as error:
            self.show_error(str(error))

    def next_area(self):
        if not self.current_route:
            self.show_error("Calculate a route first.")
            return
        if self.current_route_index < len(self.current_route) - 1:
            self.current_route_index += 1
            self.update_next_area()
            self._draw_warehouse()
        else:
            self.status_label.config(text="Route complete. All route stops have been traversed.")
            self.next_area_label.config(text="Next stop: Complete")

    def update_next_area(self):
        current = self.current_route[self.current_route_index]
        if self.current_route_index < len(self.current_route) - 1:
            nxt = self.current_route[self.current_route_index + 1]
            self.next_area_label.config(text=f"Current: {current.display_name()}  |  Next: {nxt.display_name()}")
        else:
            self.next_area_label.config(text=f"Current: {current.display_name()}  |  Next stop: Complete")
        self.status_label.config(text=f"Route progress: stop {self.current_route_index + 1} of {len(self.current_route)}")

    def reset(self):
        self.current_route = []
        self.current_route_index = 0
        self.current_items = []
        self.order_entry.delete(0, tk.END)
        self.distance_label.config(text="Route distance: — grid steps")
        self.next_area_label.config(text="Next stop: —")
        self.status_label.config(text="Enter a demo order number (1001–1004).")
        self.item_list.delete(0, tk.END)
        self._draw_warehouse()

    def show_error(self, message):
        self.status_label.config(text=f"Error: {message}")
        messagebox.showerror("Route Optimizer Error", message, parent=self)

    def _draw_warehouse(self):
        self.canvas.delete("all")
        margin_x, margin_y, building_gap = 40, 38, 55
        building_height = self.topology.rows * CELL_SIZE
        total_width = margin_x * 2 + self.topology.columns * CELL_SIZE
        total_height = margin_y * 2 + 2 * building_height + building_gap
        self.canvas.configure(scrollregion=(0, 0, total_width, total_height))
        for index, building in enumerate(Building):
            y_offset = margin_y + index * (building_height + building_gap)
            self.canvas.create_text(margin_x, y_offset - 17, text=building.value, anchor="w", font=("Arial", 12, "bold"))
            for row in range(self.topology.rows):
                for column in range(self.topology.columns):
                    location = self.topology.get_location(building, row, column)
                    x1 = margin_x + column * CELL_SIZE
                    y1 = y_offset + row * CELL_SIZE
                    blocked = self.topology.IsBlocked(location)
                    fill = "#858585" if blocked else "white"
                    self.canvas.create_rectangle(x1, y1, x1 + CELL_SIZE, y1 + CELL_SIZE, fill=fill, outline="#cccccc")
                    if blocked:
                        self.canvas.create_text(x1 + CELL_SIZE / 2, y1 + CELL_SIZE / 2, text="×", fill="white")
            # Label the configured cross-building connection in this demo.
            for location, linked in self.topology.transitions.items():
                if location.building == building:
                    x = margin_x + location.column * CELL_SIZE + CELL_SIZE / 2
                    y = y_offset + location.row * CELL_SIZE + CELL_SIZE / 2
                    self.canvas.create_oval(x - 7, y - 7, x + 7, y + 7, fill="#e6a23c", outline="black")
        self._draw_route(margin_x, margin_y, building_height, building_gap)

    def _draw_route(self, margin_x, margin_y, building_height, building_gap):
        if not self.current_route:
            return
        coords = []
        for location in self.current_route:
            building_index = 0 if location.building == Building.A else 1
            y_offset = margin_y + building_index * (building_height + building_gap)
            x = margin_x + location.column * CELL_SIZE + CELL_SIZE / 2
            y = y_offset + location.row * CELL_SIZE + CELL_SIZE / 2
            coords.append((x, y))
        for index in range(len(coords) - 1):
            x1, y1 = coords[index]
            x2, y2 = coords[index + 1]
            self.canvas.create_line(x1, y1, x2, y2, fill="blue", width=3)
        for index, (x, y) in enumerate(coords):
            if index == self.current_route_index:
                radius, fill = 8, "green"
            elif index in (0, len(coords) - 1):
                radius, fill = 6, "blue"
            else:
                radius, fill = 3, "blue"
            self.canvas.create_oval(x-radius, y-radius, x+radius, y+radius, fill=fill, outline=fill)
